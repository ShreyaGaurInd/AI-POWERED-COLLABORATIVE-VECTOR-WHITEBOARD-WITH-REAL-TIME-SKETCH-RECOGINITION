# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/collab_whiteboard"

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_jwt_key_collab_whiteboard_2025
JWT_EXPIRES_IN=7d

# Email SMTP Delivery (Optional: for real email inbox delivery)
# For Gmail: Use your Gmail address and a 16-character App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="CollabBoard <noreply@collabboard.com>"
