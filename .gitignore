@"
# Node modules
/client/node_modules/
/server/node_modules/

# Build artefacts
/client/dist/
/client/.vite/
/client/.cache/

# Environment files – never commit secrets
/server/.env
client/.env
*.env.local
*.env.*.local

# OS‑specific
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / editor folders
.vscode/
.idea/

# Misc
*.log
*.tmp
"@ | Set-Content -Path ".gitignore" -Encoding UTF8
